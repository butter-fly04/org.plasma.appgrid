<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <group name="General">
        <entry name="icon" type="String">
            <default>view-app-grid</default>
        </entry>
        <!-- Our own layout store: JSON list of {type:"app",id} / {type:"group",name,items:[ids]}.
             Lives in this applet's config only; the system menu is never touched. -->
        <entry name="layoutJson" type="String">
            <default>[]</default>
        </entry>
        <!-- App ids hidden from the launcher (JSON array). Also only in this applet's config. -->
        <entry name="hiddenJson" type="String">
            <default>[]</default>
        </entry>
        <!-- "gnome" or "system" -->
        <entry name="theme" type="String">
            <default>gnome</default>
        </entry>
        <!-- Icon size in px; 0 = automatic -->
        <entry name="iconSize" type="Int">
            <default>0</default>
        </entry>
        <!-- Horizontal / vertical spacing between icons in px; -1 = automatic -->
        <entry name="hSpacing" type="Int">
            <default>-1</default>
        </entry>
        <entry name="vSpacing" type="Int">
            <default>-1</default>
        </entry>
        <!-- Custom colours (override the chosen theme when enabled) -->
        <entry name="useCustomColors" type="Bool">
            <default>false</default>
        </entry>
        <entry name="colorBackdrop" type="String">
            <default>#0a0a0a</default>
        </entry>
        <entry name="colorBackdropOpacity" type="Int">
            <default>72</default>
        </entry>
        <entry name="colorPopup" type="String">
            <default>#2e2e2e</default>
        </entry>
        <entry name="colorText" type="String">
            <default>#ffffff</default>
        </entry>
        <entry name="colorAccent" type="String">
            <default>#3584e4</default>
        </entry>
        <entry name="animations" type="Bool">
            <default>true</default>
        </entry>
        <entry name="powerActions" type="String">
            <default>lock,sleep,hibernate,restart,shutdown,logout</default>
        </entry>
        <entry name="useCustomButtonImage" type="Bool">
            <default>false</default>
        </entry>
        <entry name="customButtonImage" type="String">
            <default></default>
        </entry>
        <!-- Installed apps as last seen by the running applet ([{id,name,icon}]), so the
             settings page can list them. Written by the applet, read-only for the page. -->
        <entry name="appCatalogJson" type="String">
            <default>[]</default>
        </entry>
    </group>
</kcfg>
